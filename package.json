{
  "name": "empocket-next",
  "version": "1.0.0",
  "private": true,
  "description": "EM Pocket — Emergency Medicine Reference (TypeScript + React + Next.js App Router, Cloudflare Pages static export)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy": "wrangler deploy",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/smoke.cjs && node scripts/interact.cjs && node scripts/pwa-a11y.cjs",
    "migrate:data": "node scripts/extract-data.mjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "playwright-core": "^1.63.0",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
